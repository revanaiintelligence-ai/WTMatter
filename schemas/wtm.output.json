{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WTM Output Contract",
  "description": "Contrato estructural de salida de WHAT'S THE MATTER? para integración con BINAH.",
  "type": "object",
  "required": [
    "methodology",
    "version",
    "status",
    "business",
    "observations",
    "hypotheses",
    "unknowns",
    "contradictions",
    "evidence",
    "questions",
    "ready_for_binah",
    "blocking_reasons",
    "traceability"
  ],
  "properties": {
    "methodology": {
      "type": "string",
      "const": "WTM"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "INITIAL",
        "COLLECTING",
        "CLARIFYING",
        "VERIFYING",
        "READY_FOR_BINAH",
        "INSUFFICIENT_INFORMATION",
        "BLOCKED",
        "COMPLETED"
      ]
    },
    "business": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": [
        "string",
        "null"
      ]
    },
    "objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "situation": {
      "type": [
        "string",
        "null"
      ]
    },
    "observations": {
      "type": "array"
    },
    "hypotheses": {
      "type": "array"
    },
    "unknowns": {
      "type": "array"
    },
    "contradictions": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "questions": {
      "type": "array"
    },
    "need_candidate": {
      "type": [
        "object",
        "null"
      ]
    },
    "conversation_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "ready_for_binah": {
      "type": "boolean"
    },
    "blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "traceability": {
      "type": "object",
      "required": [
        "source_evidence_ids",
        "observation_ids",
        "hypothesis_ids",
        "unknown_ids",
        "contradiction_ids",
        "question_ids"
      ],
      "properties": {
        "source_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hypothesis_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradiction_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "question_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}